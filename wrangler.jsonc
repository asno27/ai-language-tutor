// Cloudflare Workers 배포 설정 (GitHub에 push하면 Cloudflare가 자동으로 `npx wrangler deploy` 실행)
// - 정적 파일(index.html, css, js, data)은 그대로 사이트로 제공
// - 정적 파일에 없는 요청(/api/llm)은 worker/llm-worker.js가 처리
{
  "name": "ai-language-tutor",
  "main": "worker/llm-worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./"
  },
  // AI 요청(/api/llm)은 미국 구글 클라우드 근처에서 실행.
  // 한국 요청은 기본적으로 홍콩(HKG) 서버에서 처리되는데, Gemini API는 홍콩에서 "User location is not supported"로 거부됨.
  // (정적 파일은 영향 없이 가장 가까운 서버에서 제공)
  "placement": {
    "region": "gcp:us-central1"
  },
  // 기기 간 동기화 저장소 (D1). 첫 배포 때 Cloudflare가 자동으로 만든 DB의 ID를 고정 (다시 만들어지지 않도록)
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-language-tutor-db", "database_id": "fa45e964-ad96-45fe-ab4d-9213e852d619" }
  ],
  // 대시보드에서 추가한 텍스트 변수(GEMINI_MODEL 등)가 배포할 때 지워지지 않도록 유지
  "keep_vars": true
}
